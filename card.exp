set stty_init raw
spawn {*}$argv

remove_nulls 0
match_max 255
log_user 0

set ok [binary decode hex {90 00}]
set not_found [binary decode hex {6A 82}]

#expect [binary decode hex {a4 04 00 07 d2 76 00 00 85 01 01 00}]
expect ?*
send $not_found
expect $not_found

expect ?*
send $ok
expect $ok

expect ?*
send $ok
expect $ok

expect eof
