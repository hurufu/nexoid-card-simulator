proc expect_apdu_header {} {
    expect default exit -re [string repeat (..) 5]
    for {set j 1} {$j <= 5} {incr j} {
        lappend r $expect_out($j,string)
    }
    return $r
}

array set sw {
    ok 9000
    not_found 6A82
    not_supported 6800
}

foreach n [array names sw] {
    set sw($n) $sw($n)ADDEDBADC0DE
}

spawn {*}$argv
while {1} {
    lassign [expect_apdu_header] Cla Ins P1 P2 Lc
    expect -re ([string repeat .. [expr 0x$Lc]])(..)?
    switch $Cla$Ins {
        00A4 {
            set aid $expect_out(1,string)
            switch $aid {
                325041592E5359532E4444463031 {
                    send 6F2D840E325041592E5359532E4444463031A51BBF0C1861164F07A0000000031010500B5649534120435245444954$ok
                }
                A0000000031010 {
                    send 6F328407A0000000031010A527500B56495341204352454449549F380C9F66049F02065F2A029F3704BF0C089F5A050008400840$ok
                }
                D2760000850100 {send $sw(ok)}
                D2760000850101 {send $sw(not_found)}
                E103           {send $sw(not_found)}
                default {send $sw(not_found)}
            }
        }
        80A8 {
            send 773D57104761739001010119D241220117589472820200005F3401019F100706011103A000009F260813C91D65A910C9569F2701809F360200029F6C028000$ok
        }
        default {send $sw(not_supported)}
    }
}
